# macOS signing and notarization for `task build-all` / `task release`.
# Copy to .env (gitignored) and fill in.

# Developer ID Application identity in the login keychain
# (security find-identity -v -p codesigning)
MACOS_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# App Store Connect API key used by notarytool. A leading ~/ is expanded.
NOTARY_KEY="~/path/to/AuthKey_XXXXXXXXXX.p8"
NOTARY_KEY_ID="XXXXXXXXXX"
NOTARY_ISSUER="00000000-0000-0000-0000-000000000000"
